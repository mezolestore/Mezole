<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_material_types_tree" model="ir.ui.view">
        <field name="name">material.types.tree</field>
        <field name="model">material.types</field>
        <field name="arch" type="xml">
            <list string="Material Types">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_material_types_form" model="ir.ui.view">
        <field name="name">material.types.form</field>
        <field name="model">material.types</field>
        <field name="arch" type="xml">
            <form string="Material Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_material_types" model="ir.actions.act_window">
        <field name="name">Material Types</field>
        <field name="res_model">material.types</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_material_types_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first material type
            </p>
        </field>
    </record>

    <menuitem id="menu_material_types" action="action_material_types" name="Material Types" parent="stock.menu_product_in_config_stock" sequence="2"/>

</odoo>
